---
import CustomHeader from '../../components/header/CustomHeader.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../../components/ThemeInit.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/icons/Icon.astro';
import site from '../../config/site.json';
import '../../styles/global.css';

const routeLogin = Astro.params.username ?? '';

export async function getStaticPaths() {
  try {
    const res = await fetch(`${site.registryApi}/api/pkg/search?q=`);
    const data = await res.json();
    const logins = [...new Set((Array.isArray(data) ? data : []).map((p) => p.author).filter(Boolean))];
    return logins.map((username) => ({ params: { username } }));
  } catch {
    return [];
  }
}
---

<html lang="en">
  <head>
    <ClientRouter />
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Author | {site.siteName}</title>
    <meta name="description" content="Packages by author" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <a href="/pkg" class="inline-flex items-center gap-1.5 text-sm text-accent hover:underline mb-6">
          <Icon name="chevron-right" size={16} class="rotate-180" />
          Back to packages
        </a>
        <div id="author-content">
          <div class="text-muted text-sm">Loading packages…</div>
        </div>
      </div>
    </main>

    <Footer />

    <script define:vars={{ registryApi: site.registryApi, routeLogin }}>
    function main() {
    if (!document.getElementById('author-content')) return;
        const content = document.getElementById('author-content');
        const login = routeLogin || new URLSearchParams(window.location.search).get('login');

        function esc(s) {
          return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        if (!login) {
          content.innerHTML = `
            <div class="text-center py-12">
              <h1 class="text-xl font-semibold mb-2">No author specified</h1>
              <p class="text-muted text-sm mb-6">Use search to find a package.</p>
              <a href="/pkg" class="px-4 py-2 rounded-lg bg-accent text-white text-sm font-medium">Browse packages</a>
            </div>`;
        } else {
          loadAuthor(login);
        }

        // The search API matches name/description only, so author pages list
        // the full catalog and filter to the exact login client-side.
        async function loadAuthor(login) {
          try {
            const res = await fetch(`${registryApi}/api/pkg/search?q=`);
            const data = await res.json();
            const packages = (Array.isArray(data) ? data : []).filter((p) => p.author === login);
            document.title = `${login} | ZZ Packages`;
            if (packages.length === 0) {
              content.innerHTML = `
                <p class="text-sm font-mono text-accent mb-2">Author</p>
                <h1 class="text-2xl md:text-3xl font-semibold tracking-tight font-mono mb-6">${esc(login)}</h1>
                <div class="rounded-lg border border-border bg-surface p-8 text-center">
                  <p class="text-foreground font-medium mb-1">No packages yet</p>
                  <p class="text-muted text-sm">${esc(login)} has not published anything.</p>
                </div>`;
              return;
            }
            content.innerHTML = `
              <p class="text-sm font-mono text-accent mb-2">Developer</p>
              <h1 class="text-2xl md:text-3xl font-semibold tracking-tight font-mono mb-6">${esc(login)}</h1>
              <div class="grid grid-cols-2 gap-4 mb-8">
                <div class="rounded-lg border border-border bg-surface p-4">
                  <div class="text-xs text-faint mb-1">Published packages</div>
                  <div class="font-mono text-2xl text-foreground">${packages.length}</div>
                </div>
                <div class="rounded-lg border border-border bg-surface p-4">
                  <div class="text-xs text-faint mb-1">Latest update</div>
                  <div class="font-mono text-sm text-foreground truncate">${esc(packages[0].name)} v${esc(packages[0].latest)}</div>
                  <a href="/pkg/${encodeURIComponent(packages[0].name)}" class="text-xs text-accent hover:underline">Open →</a>
                </div>
              </div>
              <h2 class="font-medium mb-3">Packages</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                ${packages
                  .map(
                    (pkg) => `
                  <div class="rounded-xl border border-border bg-surface p-5 shadow-lg transition-all duration-200 motion-safe:hover:-translate-y-1 hover:border-blue-500/50 hover:shadow-[0_16px_50px_-12px_rgba(0,128,255,0.35)]">
                    <a href="/pkg/${encodeURIComponent(pkg.name)}" class="block group">
                      <div class="flex items-start justify-between gap-3">
                        <h3 class="font-mono font-bold text-foreground group-hover:text-blue-400">${esc(pkg.name)}</h3>
                        <span class="shrink-0 bg-blue-500/10 text-blue-400 border border-blue-500/20 px-2 py-0.5 text-xs rounded-full font-mono">v${esc(pkg.latest)}</span>
                      </div>
                      <p class="text-sm mt-1.5 leading-relaxed text-muted">${esc(pkg.description) || 'No description'}</p>
                    </a>
                    <div class="flex items-center justify-end mt-4 text-xs">
                      <button data-copy="zz add ${esc(pkg.name)}" class="copy-btn bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-1.5 rounded-lg border border-slate-700/50 flex items-center gap-2"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>copy install</span></button>
                    </div>
                  </div>`,
                  )
                  .join('')}
              </div>`;
            content.querySelectorAll('.copy-btn').forEach((btn) => {
              btn.addEventListener('click', async () => {
                const label = btn.querySelector('span');
                try {
                  await navigator.clipboard.writeText(btn.dataset.copy);
                  if (label) label.textContent = 'copied!';
                  setTimeout(() => {
                    if (label) label.textContent = 'copy install';
                  }, 1500);
                } catch {
                  if (label) label.textContent = 'copy failed';
                }
              });
            });
          } catch {
            content.innerHTML = `
              <div class="rounded-lg border border-border bg-surface p-8 text-center">
                <p class="text-foreground font-medium mb-1">No packages found</p>
                <p class="text-muted text-sm">Could not reach the registry. Try again in a moment.</p>
              </div>`;
          }
        }
    }
    document.addEventListener('astro:page-load', main);
    </script>
  </body>
</html>
