---
import CustomHeader from '../../components/header/CustomHeader.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../../components/ThemeInit.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/icons/Icon.astro';
import site from '../../config/site.json';
import '../../styles/global.css';

const routeLogin = Astro.params.username ?? '';

export async function getStaticPaths() {
  // Warm-start seed for known authors; functions/u/[username].ts (F-01)
  // serves the rest without a rebuild.
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      const res = await fetch(`${site.registryApi}/api/pkg/search?q=`);
      const data = await res.json();
      const logins = [...new Set((Array.isArray(data) ? data : []).map((p) => p.author).filter(Boolean))];
      if (logins.length > 0) {
        return logins.map((username) => ({ params: { username } }));
      }
    } catch {}
    await new Promise((r) => setTimeout(r, 2000 * attempt));
  }
  console.warn('[u/[username]] registry unreachable after retries: no pretty author URLs prerendered');
  return [];
}

const pageTitle = routeLogin ? `${routeLogin} | ZZ Packages` : `Author | ${site.siteName}`;
---

<html lang="en">
  <head>
    <ClientRouter />
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={routeLogin ? `Packages published by ${routeLogin} on ZZ.` : 'Packages by author'} />
    {routeLogin && <link rel="canonical" href={`${site.domain}/u/${encodeURIComponent(routeLogin)}`} />}
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <a href="/pkg" class="inline-flex items-center gap-1.5 text-sm text-accent hover:underline mb-6">
          <Icon name="chevron-right" size={16} class="rotate-180" />
          Back to packages
        </a>
        <div id="author-content" data-login={routeLogin}>
          <div class="text-muted text-sm">Loading packages…</div>
        </div>
      </div>
    </main>

    <Footer />

    <script>
      import { resolveSlug } from '../../lib/pkg-api';
      import { renderAuthorPage } from '../../lib/pkg-author';

      function boot() {
        const content = document.getElementById('author-content');
        if (!content || content.dataset.wired) return;
        content.dataset.wired = '1';
        renderAuthorPage(content, resolveSlug(content.dataset.login || '', 'login'));
      }
      boot();
      if (!(window as any).__zzAuthorNav) {
        (window as any).__zzAuthorNav = true;
        document.addEventListener('astro:page-load', boot);
      }
    </script>
  </body>
</html>
