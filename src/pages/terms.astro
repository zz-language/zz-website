---
import CustomHeader from '../components/header/CustomHeader.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../components/ThemeInit.astro';
import Footer from '../components/Footer.astro';
import site from '../config/site.json';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terms of Service | {site.siteName}</title>
    <meta name="description" content="ZZ Language website terms of service" />
    <ThemeInit />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />
    <main class="pt-14">
      <div class="max-w-3xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <p class="text-sm font-mono text-accent mb-2">Legal</p>
        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight mb-6">Terms of Service</h1>
        <div class="flex flex-col gap-4 text-sm text-muted leading-relaxed">
          <p>
            The ZZ programming language, its compiler, standard library, and
            package registry software are open source under the MIT License.
            The package registry hosts user-published code as-is.
          </p>
          <p>
            By publishing a package you confirm you have the right to
            distribute its contents, and you grant other users the rights
            stated in the license you attach to the package.
          </p>
          <p>
            API tokens authenticate registry writes. Keep them secret: anyone
            holding your token can publish under your name. Revoke
            compromised tokens immediately on the
            <a href="/pkg/tokens" class="text-accent hover:underline">tokens page</a>.
          </p>
          <p>
            The service is provided without warranty of any kind. Abuse
            (malware, spam, credential theft) leads to package removal and
            account suspension. To report abuse, open an issue on the
            <a
              href={`${site.githubRepo}/issues`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline"
            >GitHub repository</a>.
          </p>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
