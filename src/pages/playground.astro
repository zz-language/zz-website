---
import CustomHeader from '../components/header/CustomHeader.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../components/ThemeInit.astro';
import Footer from '../components/Footer.astro';
import PlaygroundApp from '../components/playground/PlaygroundApp';
import site from '../config/site.json';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <ClientRouter />
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Playground | {site.siteName}</title>
    <meta name="description" content="Run real ZZ code in your browser — with stdin, stdout and errors." />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <p class="text-sm font-mono text-accent mb-2">Playground</p>
        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight">Run real ZZ in your browser.</h1>
        <p class="text-muted mt-2 mb-6 max-w-xl text-sm md:text-base">
          Core ZZ executes locally — including <code class="font-mono text-foreground">input()</code>.
          When your program reads, the terminal pauses and lets you type.
        </p>

        <PlaygroundApp client:load />

        <details class="mt-6 rounded-lg border border-border bg-surface px-5 py-4 text-sm shadow-sm shadow-black/30">
          <summary class="cursor-pointer font-medium hover:text-accent">What runs here — and what doesn't</summary>
          <div class="mt-3 text-muted leading-relaxed space-y-2">
            <p>
              Supported: variables, functions, <code class="font-mono text-foreground">if</code> /
              <code class="font-mono text-foreground">while</code> / <code class="font-mono text-foreground">for</code>,
              <code class="font-mono text-foreground">match</code> on literals and
              <code class="font-mono text-foreground">Option</code>/<code class="font-mono text-foreground">Result</code>,
              closures, pipelines (<code class="font-mono text-foreground">|&gt;</code>),
              elvis (<code class="font-mono text-foreground">??</code>), string interpolation,
              arrays, dicts, structs + <code class="font-mono text-foreground">impl</code>,
              and the pure stdlib (<code class="font-mono text-foreground">str</code>,
              <code class="font-mono text-foreground">vec</code>, <code class="font-mono text-foreground">math</code>,
              <code class="font-mono text-foreground">encoding</code>, <code class="font-mono text-foreground">json</code>,
              <code class="font-mono text-foreground">io</code>, <code class="font-mono text-foreground">env</code>,
              <code class="font-mono text-foreground">time</code>).
            </p>
            <p>
              Not in the browser: <code class="font-mono text-foreground">http</code>,
              <code class="font-mono text-foreground">fs</code>, <code class="font-mono text-foreground">net</code> and
              <code class="font-mono text-foreground">db</code> need real I/O — run those with
              <code class="font-mono text-foreground">zz run</code> locally. Infinite loops are stopped by an execution limit.
            </p>
          </div>
        </details>
      </div>
    </main>

    <Footer />
  </body>
</html>
