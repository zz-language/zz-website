---
import CustomHeader from '../../components/header/CustomHeader.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../../components/ThemeInit.astro';
import Footer from '../../components/Footer.astro';
import PkgDetail from '../../components/pkg/PkgDetail.astro';
import site from '../../config/site.json';
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <ClientRouter />
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Package | {site.siteName}</title>
    <meta name="description" content="ZZ package details and install instructions." />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-4xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <PkgDetail />
      </div>
    </main>

    <Footer />

    <script>
      import { resolveSlug } from '../../lib/pkg-api';
      import { renderPkgDetail } from '../../lib/pkg-detail';

      function boot() {
        const content = document.getElementById('pkg-content');
        if (!content || content.dataset.wired) return;
        content.dataset.wired = '1';
        renderPkgDetail(content, resolveSlug(content.dataset.route || '', 'name'));
      }
      boot();
      if (!(window as any).__zzPkgDetailNav) {
        (window as any).__zzPkgDetailNav = true;
        document.addEventListener('astro:page-load', boot);
      }
    </script>
  </body>
</html>
