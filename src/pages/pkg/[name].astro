---
import CustomHeader from '../../components/header/CustomHeader.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../../components/ThemeInit.astro';
import Footer from '../../components/Footer.astro';
import PkgDetail from '../../components/pkg/PkgDetail.astro';
import site from '../../config/site.json';
import '../../styles/global.css';

const routeName = Astro.params.name ?? '';

export async function getStaticPaths() {
  // Warm-start seed: instant HTML for catalog names known at build time.
  // Names published later are served by functions/pkg/[name].ts (F-01),
  // so a missing seed entry is a cold start, never a 404.
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      const res = await fetch(`${site.registryApi}/api/pkg/search?q=`);
      const data = await res.json();
      if (Array.isArray(data) && data.length > 0) {
        return data.map((p) => ({ params: { name: p.name } }));
      }
    } catch {}
    await new Promise((r) => setTimeout(r, 2000 * attempt));
  }
  console.warn('[pkg/[name]] registry unreachable after retries: no pretty package URLs prerendered');
  return [];
}

// Crawler-safe SEO (F-11): bake per-package title/meta/JSON-LD at build
// time for seeded names. Single attempt, short timeout — cold registries
// fall back to generic tags and the client upgrades them post-load.
let seo = { title: 'Package', description: 'ZZ package details and install instructions.', version: '', author: '', license: '' };
if (routeName) {
  try {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 4000);
    const res = await fetch(`${site.registryApi}/api/pkg/${encodeURIComponent(routeName)}`, { signal: ctrl.signal });
    clearTimeout(timer);
    if (res.ok) {
      const pkg = await res.json();
      const md = pkg.metadata ?? {};
      seo = {
        title: `${md.name} v${md.latest}`,
        description: md.description || 'ZZ package details and install instructions.',
        version: md.latest || '',
        author: md.author || '',
        license: md.license || '',
      };
    }
  } catch {}
}
const pageTitle = routeName ? `${seo.title} | ZZ Packages` : `Package | ${site.siteName}`;
const canonical = `${site.domain}/pkg/${encodeURIComponent(routeName)}`;
---

<html lang="en">
  <head>
    <ClientRouter />
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.domain + site.ogImage} />
    <meta name="twitter:card" content="summary" />
    {routeName && seo.version && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: routeName,
        version: seo.version,
        author: seo.author,
        license: seo.license,
        description: seo.description,
        url: canonical,
      })} />
    )}
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-4xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <PkgDetail routeName={routeName} />
      </div>
    </main>

    <Footer />

    <script>
      import { resolveSlug } from '../../lib/pkg-api';
      import { renderPkgDetail } from '../../lib/pkg-detail';

      function boot() {
        const content = document.getElementById('pkg-content');
        if (!content || content.dataset.wired) return;
        content.dataset.wired = '1';
        renderPkgDetail(content, resolveSlug(content.dataset.route || '', 'name'));
      }
      boot();
      // Guarded: inline scripts re-execute on every View-Transitions
      // navigation, but the document handler must be registered once.
      if (!(window as any).__zzPkgDetailNav) {
        (window as any).__zzPkgDetailNav = true;
        document.addEventListener('astro:page-load', boot);
      }
    </script>
  </body>
</html>
