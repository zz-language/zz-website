---
import CustomHeader from '../../components/header/CustomHeader.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../../components/ThemeInit.astro';
import Footer from '../../components/Footer.astro';
import PkgDetail from '../../components/pkg/PkgDetail.astro';
import site from '../../config/site.json';
import '../../styles/global.css';

const routeName = Astro.params.name ?? '';

// Intentionally NOT prerendered: the Pages Function fallback
// (functions/pkg/[name].ts) serves this shell for every name, so new
// packages resolve without a rebuild and builds never crawl the registry.
export async function getStaticPaths() {
  return [];
}

const pageTitle = routeName ? `${routeName} | ZZ Packages` : `Package | ${site.siteName}`;
const canonical = `${site.domain}/pkg/${encodeURIComponent(routeName)}`;
---

<html lang="en">
  <head>
    <ClientRouter />
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content="ZZ package details and install instructions." />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.domain + site.ogImage} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-4xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <PkgDetail routeName={routeName} />
      </div>
    </main>

    <Footer />

    <script>
      import { resolveSlug } from '../../lib/pkg-api';
      import { renderPkgDetail, wirePkgDetail } from '../../lib/pkg-detail';

      function boot() {
        const content = document.getElementById('pkg-content');
        if (!content || content.dataset.wired) return;
        content.dataset.wired = '1';
        if (content.dataset.ssr === '1') {
          wirePkgDetail(content);
        } else {
          renderPkgDetail(content, resolveSlug(content.dataset.route || '', 'name'));
        }
      }
      boot();
      // Guarded: inline scripts re-execute on every View-Transitions
      // navigation, but the document handler must be registered once.
      if (!(window as any).__zzPkgDetailNav) {
        (window as any).__zzPkgDetailNav = true;
        document.addEventListener('astro:page-load', boot);
      }
    </script>
  </body>
</html>
