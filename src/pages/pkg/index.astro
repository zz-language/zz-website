---
import CustomHeader from '../../components/header/CustomHeader.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/icons/Icon.astro';
import { inputClasses } from '../../components/ui/input';
import site from '../../config/site.json';
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Packages | {site.siteName}</title>
    <meta name="description" content="Discover and install ZZ packages" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <p class="text-sm font-mono text-accent mb-2">Registry</p>
        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight">Packages</h1>
        <p class="text-muted mt-2 mb-8">Discover and install ZZ packages.</p>

        <div class="flex flex-wrap items-center gap-3 max-w-xl mb-8">
          <div class="relative flex-1 min-w-52">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-faint">
              <Icon name="search" size={16} />
            </span>
            <label for="pkg-search" class="sr-only">Search packages</label>
            <input
              id="pkg-search"
              type="text"
              placeholder="Search packages..."
              autocomplete="off"
              class={inputClasses + ' pl-10'}
            />
          </div>
          <label for="pkg-author" class="sr-only">Filter by author</label>
          <select id="pkg-author" class={inputClasses + ' w-auto'}>
            <option value="">All authors</option>
          </select>
          <label for="pkg-sort" class="sr-only">Sort packages</label>
          <select id="pkg-sort" class={inputClasses + ' w-auto'}>
            <option value="recent">Recently updated</option>
            <option value="name">Name A–Z</option>
          </select>
        </div>

        <div id="pkg-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="rounded-lg border border-border bg-surface p-6 text-muted text-sm">Loading packages…</div>
        </div>
      </div>
    </main>

    <Footer />

    <script define:vars={{ registryApi: site.registryApi }}>
      const searchInput = document.getElementById('pkg-search');
      const authorSelect = document.getElementById('pkg-author');
      const sortSelect = document.getElementById('pkg-sort');
      const pkgList = document.getElementById('pkg-list');
      let allPackages = [];

      async function fetchPackages(query) {
        try {
          const url = query
            ? `${registryApi}/api/pkg/search?q=${encodeURIComponent(query)}`
            : `${registryApi}/api/pkg/search?q=`;
          const res = await fetch(url);
          const data = await res.json();
          allPackages = Array.isArray(data) ? data : [];
          refreshAuthors();
          renderPackages();
        } catch {
          renderEmpty('Could not reach the registry. Try again in a moment.');
        }
      }

      // Author filter options derive from the result set: the search API
      // has no author query, so filtering happens client-side.
      function refreshAuthors() {
        const current = authorSelect.value;
        const authors = [...new Set(allPackages.map((p) => p.author).filter(Boolean))].sort();
        authorSelect.innerHTML =
          '<option value="">All authors</option>' +
          authors.map((a) => `<option value="${esc(a)}">${esc(a)}</option>`).join('');
        if (authors.includes(current)) authorSelect.value = current;
      }

      function visiblePackages() {
        const author = authorSelect.value;
        const sort = sortSelect.value;
        let list = author ? allPackages.filter((p) => p.author === author) : allPackages.slice();
        if (sort === 'name') list.sort((a, b) => String(a.name).localeCompare(String(b.name)));
        return list;
      }

      function renderPackages() {
        const packages = visiblePackages();
        if (packages.length === 0) {
          renderEmpty();
          return;
        }
        pkgList.innerHTML = packages
          .map(
            (pkg) => `
          <div class="rounded-lg border border-border bg-surface p-5">
            <a href="/pkg/view?name=${encodeURIComponent(pkg.name)}" class="block hover:border-accent-border">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-mono font-medium text-foreground">${esc(pkg.name)}</h3>
                <span class="shrink-0 text-accent text-sm font-mono">v${esc(pkg.latest)}</span>
              </div>
              <p class="text-muted text-sm mt-1.5 leading-relaxed">${esc(pkg.description) || 'No description'}</p>
            </a>
            <div class="flex items-center justify-between mt-4 text-xs">
              <a href="/pkg/author?login=${encodeURIComponent(pkg.author || '')}" class="text-faint hover:text-accent">${esc(pkg.author)}</a>
              <button data-copy="zz add ${esc(pkg.name)}" class="copy-btn text-accent font-mono hover:underline">copy install</button>
            </div>
          </div>`,
          )
          .join('');
        pkgList.querySelectorAll('.copy-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(btn.dataset.copy);
              btn.textContent = 'copied!';
              setTimeout(() => (btn.textContent = 'copy install'), 1500);
            } catch {
              btn.textContent = 'copy failed';
            }
          });
        });
      }

      function renderEmpty(note) {
        pkgList.innerHTML = `
          <div class="rounded-lg border border-border bg-surface p-8 text-center md:col-span-2 lg:col-span-3">
            <p class="text-foreground font-medium mb-1">No packages found</p>
            <p class="text-muted text-sm mb-4">${note || 'Be the first to publish a package.'}</p>
            <code class="inline-block px-3 py-1.5 bg-background border border-border rounded-md text-accent text-sm font-mono">zz publish</code>
          </div>`;
      }

      function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      let timeout;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => fetchPackages(e.target.value.trim()), 300);
      });
      authorSelect.addEventListener('change', renderPackages);
      sortSelect.addEventListener('change', renderPackages);

      fetchPackages('');
    </script>
  </body>
</html>
