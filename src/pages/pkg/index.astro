---
import CustomHeader from '../../components/header/CustomHeader.astro';
import site from '../../config/site.json';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Packages | {site.siteName}</title>
    <meta name="description" content="Browse ZZ packages" />
  </head>
  <body class="bg-[#0F172A] text-[#F8FAFC] font-body antialiased">
    <CustomHeader />

    <main class="pt-16 min-h-screen">
      <div class="max-w-7xl mx-auto px-4 md:px-8 py-12">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h1 class="text-3xl font-bold text-[#F8FAFC] font-mono">Packages</h1>
            <p class="text-[#94A3B8] mt-2">Discover and install ZZ packages</p>
          </div>
        </div>

        {/* Search */}
        <div class="mb-8">
          <div class="relative max-w-xl">
            <input
              id="pkg-search"
              type="text"
              placeholder="Search packages..."
              class="w-full bg-[#111827] border border-[#475569] text-[#F8FAFC] rounded-xl px-4 py-3 pl-10 text-sm font-mono focus:border-[#22C55E] focus:outline-none transition-colors"
            />
            <svg class="absolute left-3 top-3.5 w-4 h-4 text-[#94A3B8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
        </div>

        {/* Package list */}
        <div id="pkg-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="bg-[#111827] rounded-xl border border-[#475569]/50 p-6 text-center text-[#94A3B8]">
            Loading packages...
          </div>
        </div>
      </div>
    </main>

    <script>
      const searchInput = document.getElementById('pkg-search') as HTMLInputElement;
      const pkgList = document.getElementById('pkg-list')!;

      let allPackages: any[] = [];

      async function fetchPackages(query = '') {
        try {
          const url = query ? `/api/pkg/search?q=${encodeURIComponent(query)}` : '/api/pkg/search?q=';
          const res = await fetch(url);
          const data = await res.json();
          allPackages = data;
          renderPackages(data);
        } catch {
          // Show empty state for demo
          pkgList.innerHTML = `
            <div class="bg-[#111827] rounded-xl border border-[#475569]/50 p-6 text-center">
              <p class="text-[#94A3B8] mb-2">No packages found</p>
              <p class="text-[#475569] text-sm">Be the first to publish a package!</p>
              <code class="inline-block mt-4 px-3 py-1 bg-[#0F172A] rounded text-[#22C55E] text-sm font-mono">zz pkg publish</code>
            </div>
          `;
        }
      }

      function renderPackages(packages: any[]) {
        if (packages.length === 0) {
          pkgList.innerHTML = `
            <div class="bg-[#111827] rounded-xl border border-[#475569]/50 p-6 text-center">
              <p class="text-[#94A3B8] mb-2">No packages found</p>
              <p class="text-[#475569] text-sm">Be the first to publish a package!</p>
            </div>
          `;
          return;
        }

        pkgList.innerHTML = packages.map((pkg: any) => `
          <a href="/pkg/view?name=${pkg.name}" class="block bg-[#111827] rounded-xl border border-[#475569]/50 p-6 hover:border-[#22C55E]/30 transition-colors">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-[#F8FAFC] font-mono font-semibold">${pkg.name}</h3>
                <p class="text-[#94A3B8] text-sm mt-1">${pkg.description || 'No description'}</p>
              </div>
              <span class="text-[#22C55E] text-sm font-mono">v${pkg.latest}</span>
            </div>
            <div class="flex items-center gap-4 mt-4 text-xs text-[#475569]">
              <span>${pkg.author}</span>
              <span class="flex items-center gap-1">
                <code class="text-[#22C55E]">zz pkg add ${pkg.name}</code>
              </span>
            </div>
          </a>
        `).join('');
      }

      // Debounced search
      let timeout: ReturnType<typeof setTimeout>;
      searchInput?.addEventListener('input', (e) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => {
          fetchPackages((e.target as HTMLInputElement).value);
        }, 300);
      });

      // Initial load
      fetchPackages();
    </script>
  </body>
</html>
