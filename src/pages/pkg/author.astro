---
import CustomHeader from '../../components/header/CustomHeader.astro';
import ThemeInit from '../../components/ThemeInit.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/icons/Icon.astro';
import site from '../../config/site.json';
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Author | {site.siteName}</title>
    <meta name="description" content="Packages by author" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <CustomHeader />

    <main class="pt-14">
      <div class="max-w-6xl mx-auto px-4 md:px-6 py-10 md:py-14">
        <a href="/pkg" class="inline-flex items-center gap-1.5 text-sm text-accent hover:underline mb-6">
          <Icon name="chevron-right" size={16} class="rotate-180" />
          Back to packages
        </a>
        <div id="author-content">
          <div class="text-muted text-sm">Loading packages…</div>
        </div>
      </div>
    </main>

    <Footer />

    <script define:vars={{ registryApi: site.registryApi }}>
      const content = document.getElementById('author-content');
      const login = new URLSearchParams(window.location.search).get('login');

      function esc(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      if (!login) {
        content.innerHTML = `
          <div class="text-center py-12">
            <h1 class="text-xl font-semibold mb-2">No author specified</h1>
            <p class="text-muted text-sm mb-6">Use search to find a package.</p>
            <a href="/pkg" class="px-4 py-2 rounded-lg bg-accent text-white text-sm font-medium">Browse packages</a>
          </div>`;
      } else {
        loadAuthor(login);
      }

      // The search API matches name/description only, so author pages list
      // the full catalog and filter to the exact login client-side.
      async function loadAuthor(login) {
        try {
          const res = await fetch(`${registryApi}/api/pkg/search?q=`);
          const data = await res.json();
          const packages = (Array.isArray(data) ? data : []).filter((p) => p.author === login);
          document.title = `${login} | ZZ Packages`;
          if (packages.length === 0) {
            content.innerHTML = `
              <p class="text-sm font-mono text-accent mb-2">Author</p>
              <h1 class="text-2xl md:text-3xl font-semibold tracking-tight font-mono mb-6">${esc(login)}</h1>
              <div class="rounded-lg border border-border bg-surface p-8 text-center">
                <p class="text-foreground font-medium mb-1">No packages yet</p>
                <p class="text-muted text-sm">${esc(login)} has not published anything.</p>
              </div>`;
            return;
          }
          content.innerHTML = `
            <p class="text-sm font-mono text-accent mb-2">Author</p>
            <h1 class="text-2xl md:text-3xl font-semibold tracking-tight font-mono mb-6">${esc(login)}</h1>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              ${packages
                .map(
                  (pkg) => `
                <div class="rounded-lg border border-border bg-surface p-5">
                  <a href="/pkg/view?name=${encodeURIComponent(pkg.name)}" class="block">
                    <div class="flex items-start justify-between gap-3">
                      <h3 class="font-mono font-medium text-foreground">${esc(pkg.name)}</h3>
                      <span class="shrink-0 text-accent text-sm font-mono">v${esc(pkg.latest)}</span>
                    </div>
                    <p class="text-muted text-sm mt-1.5 leading-relaxed">${esc(pkg.description) || 'No description'}</p>
                  </a>
                  <div class="flex items-center justify-end mt-4 text-xs">
                    <button data-copy="zz add ${esc(pkg.name)}" class="copy-btn text-accent font-mono hover:underline">copy install</button>
                  </div>
                </div>`,
                )
                .join('')}
            </div>`;
          content.querySelectorAll('.copy-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(btn.dataset.copy);
                btn.textContent = 'copied!';
                setTimeout(() => (btn.textContent = 'copy install'), 1500);
              } catch {
                btn.textContent = 'copy failed';
              }
            });
          });
        } catch {
          content.innerHTML = `
            <div class="rounded-lg border border-border bg-surface p-8 text-center">
              <p class="text-foreground font-medium mb-1">No packages found</p>
              <p class="text-muted text-sm">Could not reach the registry. Try again in a moment.</p>
            </div>`;
        }
      }
    </script>
  </body>
</html>
