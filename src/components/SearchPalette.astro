---
import site from '../config/site.json';

interface DocEntry {
  title: string;
  path: string;
  group: string;
}

// Stable docs index (mirrors the Starlight sidebar slugs).
const DOCS: DocEntry[] = [
  { title: 'Introduction', path: '/getting-started', group: 'Docs' },
  { title: 'Syntax tour', path: '/syntax', group: 'Docs' },
  { title: 'Language Reference', path: '/language-reference', group: 'Docs' },
  { title: 'Error Handling', path: '/error-handling', group: 'Docs' },
  { title: 'Best Practices', path: '/best-practices', group: 'Docs' },
  { title: 'Standard Library Overview', path: '/stdlib/overview', group: 'Docs' },
  { title: 'std.str — Strings', path: '/stdlib/str', group: 'Docs' },
  { title: 'std.vec — Arrays', path: '/stdlib/vec', group: 'Docs' },
  { title: 'std.json — JSON', path: '/stdlib/json', group: 'Docs' },
  { title: 'std.http — HTTP client + server', path: '/stdlib/http', group: 'Docs' },
  { title: 'std.fs — Filesystem', path: '/stdlib/fs', group: 'Docs' },
  { title: 'std.env — Environment', path: '/stdlib/env', group: 'Docs' },
  { title: 'std.math — Math', path: '/stdlib/math', group: 'Docs' },
  { title: 'std.time — Time', path: '/stdlib/time', group: 'Docs' },
  { title: 'std.encoding — Base64, hex, URL', path: '/stdlib/encoding', group: 'Docs' },
  { title: 'std.net — TCP networking', path: '/stdlib/net', group: 'Docs' },
  { title: 'Async Sockets', path: '/async-sockets', group: 'Docs' },
  { title: 'Advanced Features', path: '/advanced', group: 'Docs' },
];

const ICONS: Record<string, string> = {
  doc: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>',
  pkg: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>',
  action:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
};
---

<div
  id="zz-palette"
  class="hidden fixed inset-0 z-[100]"
  role="dialog"
  aria-modal="true"
  aria-label="Quick search"
>
  <div id="zz-palette-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
  <div class="zz-palette-panel absolute left-1/2 top-[10vh] w-[calc(100%-2rem)] max-w-xl -translate-x-1/2 overflow-hidden rounded-2xl border border-white/10 bg-[#0B0F17]/95 shadow-[0_24px_80px_-12px_rgba(0,0,0,0.8),0_0_0_1px_rgba(255,255,255,0.04),0_0_60px_-20px_rgba(0,128,255,0.25)] backdrop-blur-xl">
    <div class="zz-palette-inputrow flex items-center gap-3 border-b border-white/[0.06] px-5 transition-colors">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-blue-400 shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <label for="zz-palette-input" class="sr-only">Search docs, packages and actions</label>
      <input
        id="zz-palette-input"
        type="text"
        placeholder="Type a command or search..."
        autocomplete="off"
        class="w-full bg-transparent py-4 text-[15px] text-slate-100 placeholder:text-slate-600"
      />
      <kbd class="font-mono text-[11px] text-slate-500 bg-white/[0.04] border border-white/10 rounded-md px-1.5 py-0.5">esc</kbd>
    </div>
    <div id="zz-palette-results" class="max-h-[46vh] overflow-y-auto p-2" role="listbox"></div>
    <div class="flex items-center gap-5 border-t border-white/[0.06] px-5 py-2.5 text-xs text-slate-500">
      <span class="flex items-center gap-1.5"><kbd class="font-mono bg-white/[0.04] border border-white/10 rounded-md px-1.5 py-0.5 text-[11px]">↑↓</kbd> navigate</span>
      <span class="flex items-center gap-1.5"><kbd class="font-mono bg-white/[0.04] border border-white/10 rounded-md px-1.5 py-0.5 text-[11px]">↵</kbd> select</span>
      <span class="flex items-center gap-1.5"><kbd class="font-mono bg-white/[0.04] border border-white/10 rounded-md px-1.5 py-0.5 text-[11px]">esc</kbd> close</span>
    </div>
  </div>
</div>

<style>
  #zz-palette-input:focus {
    outline: none !important;
    box-shadow: none !important;
  }
  .zz-palette-panel:focus-within .zz-palette-inputrow {
    border-bottom-color: rgba(0, 128, 255, 0.4);
  }
  .zz-palette-panel {
    animation: zz-palette-in 160ms ease-out;
  }
  @keyframes zz-palette-in {
    from {
      opacity: 0;
      transform: translateX(-50%) scale(0.98) translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) scale(1) translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .zz-palette-panel {
      animation: none;
    }
  }
</style>

<script define:vars={{ registryApi: site.registryApi, docs: DOCS, icons: ICONS }}>
  let pkgCache = null;
  let items = [];
  let active = 0;

  // Element refs are re-queried per navigation: after a client-side swap
  // the previous nodes are detached, so module-level consts would go stale.
  function refs() {
    return {
      palette: document.getElementById('zz-palette'),
      input: document.getElementById('zz-palette-input'),
      results: document.getElementById('zz-palette-results'),
    };
  }

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function session() {
    try {
      const login = localStorage.getItem('zz_login') || '';
      const token = localStorage.getItem('zz_token') || '';
      return login && token ? { login } : null;
    } catch {
      return null;
    }
  }

  function actions() {
    const list = [
      { title: 'Go to Playground', hint: 'Action', run: () => (window.location.href = '/playground') },
      { title: 'Toggle theme', hint: 'Action', run: () => document.getElementById('theme-toggle')?.click() },
      { title: 'Browse packages', hint: 'Action', run: () => (window.location.href = '/pkg') },
      { title: 'ZZ on GitHub', hint: 'Action', run: () => window.open('https://github.com/zz-language/zz', '_blank', 'noopener') },
    ];
    const s = session();
    if (s) {
      list.unshift({
        title: `My packages (@${s.login})`,
        hint: 'Action',
        run: () => (window.location.href = `/u/${encodeURIComponent(s.login)}`),
      });
      list.unshift({
        title: 'API tokens',
        hint: 'Action',
        run: () => (window.location.href = '/pkg/tokens'),
      });
    }
    return list;
  }

  async function packages() {
    if (pkgCache) return pkgCache;
    try {
      const res = await fetch(`${registryApi}/api/pkg/search?q=`);
      const data = await res.json();
      pkgCache = (Array.isArray(data) ? data : []).map((p) => ({
        title: p.name,
        sub: `v${p.latest || '?'} · ${p.author || 'unknown'}`,
        path: `/pkg/${encodeURIComponent(p.name)}`,
        group: 'Packages',
      }));
    } catch {
      pkgCache = [];
    }
    return pkgCache;
  }

  // Subsequence fuzzy match; prefix and word-boundary hits rank first.
  function score(title, q) {
    const t = title.toLowerCase();
    if (t.startsWith(q)) return 3;
    if (t.includes(q)) return 2;
    let ti = 0;
    for (let qi = 0; qi < q.length; qi++) {
      ti = t.indexOf(q[qi], ti);
      if (ti < 0) return 0;
      ti++;
    }
    return 1;
  }

  async function search(q) {
    const query = q.trim().toLowerCase();
    const pkgs = await packages();
    const acts = actions();
    const pool = [
      ...acts.map((a) => ({ ...a, kind: 'action' })),
      ...docs.map((d) => ({ ...d, kind: 'link' })),
      ...pkgs.map((p) => ({ ...p, kind: 'link' })),
    ];
    const ranked = query
      ? pool
          .map((it) => ({ it, s: Math.max(score(it.title, query), it.sub ? score(it.sub, query) - 1 : 0) }))
          .filter((r) => r.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 12)
          .map((r) => r.it)
      : [...acts.slice(0, 4).map((a) => ({ ...a, kind: 'action' })), ...pkgs.slice(0, 4)];
    return ranked;
  }

  function kindIcon(kind, group) {
    if (kind === 'action') return icons.action;
    if (group === 'Packages') return icons.pkg;
    return icons.doc;
  }

  const ROW_BASE =
    'display:flex;width:calc(100% - 1rem);margin-left:0.5rem;margin-right:0.5rem;' +
    'align-items:center;gap:0.75rem;border-radius:0.75rem;border:1px solid transparent;' +
    'padding:0.625rem 0.75rem;font-size:0.875rem;text-align:left;cursor:pointer;background:transparent;' +
    'transition:background-color 120ms ease,border-color 120ms ease;';
  const ROW_ACTIVE =
    'background:rgba(0,128,255,0.14);border-color:rgba(0,128,255,0.35);';

  function render(list) {
    const { results } = refs();
    if (!results) return;
    items = list;
    active = 0;
    if (list.length === 0) {
      results.innerHTML =
        '<div class="px-4 py-8 text-center"><div class="text-sm text-slate-400">No matches</div><div class="mt-1 text-xs text-slate-600">Try docs, a package name, or an action</div></div>';
      return;
    }
    let lastGroup = '';
    results.innerHTML = list
      .map((it, i) => {
        const head =
          it.group && it.group !== lastGroup
            ? `<div class="px-3 pt-2.5 pb-1 text-[11px] font-semibold text-slate-500 uppercase tracking-[0.08em]">${esc(it.group)}</div>`
            : '';
        lastGroup = it.group || lastGroup;
        return `${head}<button data-idx="${i}" role="option" aria-selected="${i === 0}" class="palette-item" style="${ROW_BASE}"><span class="shrink-0 text-slate-500">${kindIcon(it.kind, it.group)}</span><span class="palette-title min-w-0 flex-1 truncate font-medium" style="color:#e2e8f0">${esc(it.title)}</span><span class="shrink-0 text-xs" style="color:#475569">${esc(it.sub || it.hint || '')}</span></button>`;
      })
      .join('');
    highlight();
    results.querySelectorAll('.palette-item').forEach((btn) => {
      btn.addEventListener('click', () => activate(parseInt(btn.dataset.idx, 10)));
      btn.addEventListener('mousemove', () => {
        const i = parseInt(btn.dataset.idx, 10);
        if (i !== active) {
          active = i;
          highlight();
        }
      });
    });
  }

  function highlight() {
    const { results } = refs();
    if (!results) return;
    // Inline styles (not classes): rows are injected via innerHTML, so
    // Astro-scoped <style> selectors never match them.
    results.querySelectorAll('.palette-item').forEach((btn, i) => {
      const on = i === active;
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
      btn.setAttribute('style', ROW_BASE + (on ? ROW_ACTIVE : ''));
      const title = btn.querySelector('.palette-title');
      if (title) title.setAttribute('style', `color:${on ? '#93c5fd' : '#e2e8f0'}`);
      if (on) btn.scrollIntoView({ block: 'nearest' });
    });
  }

  function activate(i) {
    const it = items[i];
    if (!it) return;
    close();
    if (it.kind === 'action') it.run();
    else window.location.href = it.path;
  }

  function open() {
    const { palette, input } = refs();
    if (!palette || !input) return;
    palette.classList.remove('hidden');
    input.value = '';
    search('').then(render);
    setTimeout(() => input.focus(), 0);
  }

  function close() {
    refs().palette?.classList.add('hidden');
  }

  // Per-navigation wiring. The palette lives inside the persisted header,
  // so its nodes survive swaps: wire once per node, not once per load.
  function main() {
    const { input } = refs();
    if (!input || input.dataset.zzWired) return;
    input.dataset.zzWired = '1';
    let debounce;
    input.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => search(input.value).then(render), 120);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        active = Math.min(active + 1, items.length - 1);
        highlight();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        active = Math.max(active - 1, 0);
        highlight();
      } else if (e.key === 'Enter') {
        activate(active);
      } else if (e.key === 'Escape') {
        close();
      }
    });
    document.getElementById('zz-palette-backdrop')?.addEventListener('click', close);
  }

  // Window listener registered once: re-runs would stack duplicate opens.
  if (!window.__zzPaletteWired) {
    window.__zzPaletteWired = true;
    window.addEventListener('zz-open-palette', open);
  }
  document.addEventListener('astro:page-load', main);
</script>
