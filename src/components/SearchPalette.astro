---
import site from '../config/site.json';

interface DocEntry {
  title: string;
  path: string;
  group: string;
}

// Stable docs index (mirrors the Starlight sidebar slugs).
const DOCS: DocEntry[] = [
  { title: 'Introduction', path: '/getting-started', group: 'Docs' },
  { title: 'Syntax tour', path: '/syntax', group: 'Docs' },
  { title: 'Language Reference', path: '/language-reference', group: 'Docs' },
  { title: 'Error Handling', path: '/error-handling', group: 'Docs' },
  { title: 'Best Practices', path: '/best-practices', group: 'Docs' },
  { title: 'Standard Library Overview', path: '/stdlib/overview', group: 'Docs' },
  { title: 'std.str — Strings', path: '/stdlib/str', group: 'Docs' },
  { title: 'std.vec — Arrays', path: '/stdlib/vec', group: 'Docs' },
  { title: 'std.json — JSON', path: '/stdlib/json', group: 'Docs' },
  { title: 'std.http — HTTP client + server', path: '/stdlib/http', group: 'Docs' },
  { title: 'std.fs — Filesystem', path: '/stdlib/fs', group: 'Docs' },
  { title: 'std.env — Environment', path: '/stdlib/env', group: 'Docs' },
  { title: 'std.math — Math', path: '/stdlib/math', group: 'Docs' },
  { title: 'std.time — Time', path: '/stdlib/time', group: 'Docs' },
  { title: 'std.encoding — Base64, hex, URL', path: '/stdlib/encoding', group: 'Docs' },
  { title: 'std.net — TCP networking', path: '/stdlib/net', group: 'Docs' },
  { title: 'Async Sockets', path: '/async-sockets', group: 'Docs' },
  { title: 'Advanced Features', path: '/advanced', group: 'Docs' },
];
---

<div
  id="zz-palette"
  class="hidden fixed inset-0 z-[100]"
  role="dialog"
  aria-modal="true"
  aria-label="Quick search"
>
  <div id="zz-palette-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="absolute left-1/2 top-[12vh] w-[calc(100%-2rem)] max-w-xl -translate-x-1/2 overflow-hidden rounded-xl border border-slate-800 bg-slate-900/95 shadow-2xl shadow-black/60 backdrop-blur-md">
    <div class="flex items-center gap-2 border-b border-slate-800 px-4">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-slate-400 shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <label for="zz-palette-input" class="sr-only">Search docs, packages and actions</label>
      <input
        id="zz-palette-input"
        type="text"
        placeholder="Type a command or search..."
        autocomplete="off"
        class="w-full bg-transparent py-3.5 text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none"
      />
      <kbd class="font-mono text-xs text-slate-400 bg-slate-800 border border-slate-700 rounded px-1.5 py-0.5">esc</kbd>
    </div>
    <div id="zz-palette-results" class="max-h-[50vh] overflow-y-auto p-1.5" role="listbox"></div>
    <div class="flex items-center gap-4 border-t border-slate-800 px-4 py-2.5 text-xs text-slate-400">
      <span><kbd class="font-mono bg-slate-800 border border-slate-700 rounded px-1.5 py-0.5 text-xs">↑↓</kbd> navigate</span>
      <span><kbd class="font-mono bg-slate-800 border border-slate-700 rounded px-1.5 py-0.5 text-xs">↵</kbd> select</span>
      <span><kbd class="font-mono bg-slate-800 border border-slate-700 rounded px-1.5 py-0.5 text-xs">esc</kbd> close</span>
    </div>
  </div>
</div>

<script define:vars={{ registryApi: site.registryApi, docs: DOCS }}>
  const palette = document.getElementById('zz-palette');
  const input = document.getElementById('zz-palette-input');
  const results = document.getElementById('zz-palette-results');
  let pkgCache = null;
  let items = [];
  let active = 0;

  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function session() {
    try {
      const login = localStorage.getItem('zz_login') || '';
      const token = localStorage.getItem('zz_token') || '';
      return login && token ? { login } : null;
    } catch {
      return null;
    }
  }

  function actions() {
    const list = [
      { title: 'Go to Playground', hint: 'Action', run: () => (window.location.href = '/playground') },
      { title: 'Toggle theme', hint: 'Action', run: () => document.getElementById('theme-toggle')?.click() },
      { title: 'Browse packages', hint: 'Action', run: () => (window.location.href = '/pkg') },
      { title: 'ZZ on GitHub', hint: 'Action', run: () => window.open('https://github.com/zz-language/zz', '_blank', 'noopener') },
    ];
    const s = session();
    if (s) {
      list.unshift({
        title: `My packages (@${s.login})`,
        hint: 'Action',
        run: () => (window.location.href = `/pkg/author?login=${encodeURIComponent(s.login)}`),
      });
      list.unshift({
        title: 'API tokens',
        hint: 'Action',
        run: () => (window.location.href = '/pkg/tokens'),
      });
    }
    return list;
  }

  async function packages() {
    if (pkgCache) return pkgCache;
    try {
      const res = await fetch(`${registryApi}/api/pkg/search?q=`);
      const data = await res.json();
      pkgCache = (Array.isArray(data) ? data : []).map((p) => ({
        title: p.name,
        sub: `v${p.latest || '?'} · ${p.author || 'unknown'}`,
        path: `/pkg/view?name=${encodeURIComponent(p.name)}`,
        group: 'Packages',
      }));
    } catch {
      pkgCache = [];
    }
    return pkgCache;
  }

  // Subsequence fuzzy match; prefix and word-boundary hits rank first.
  function score(title, q) {
    const t = title.toLowerCase();
    if (t.startsWith(q)) return 3;
    if (t.includes(q)) return 2;
    let ti = 0;
    for (let qi = 0; qi < q.length; qi++) {
      ti = t.indexOf(q[qi], ti);
      if (ti < 0) return 0;
      ti++;
    }
    return 1;
  }

  async function search(q) {
    const query = q.trim().toLowerCase();
    const pkgs = await packages();
    const acts = actions();
    const pool = [
      ...acts.map((a) => ({ ...a, kind: 'action' })),
      ...docs.map((d) => ({ ...d, kind: 'link' })),
      ...pkgs.map((p) => ({ ...p, kind: 'link' })),
    ];
    const ranked = query
      ? pool
          .map((it) => ({ it, s: Math.max(score(it.title, query), it.sub ? score(it.sub, query) - 1 : 0) }))
          .filter((r) => r.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 12)
          .map((r) => r.it)
      : [...acts.slice(0, 4).map((a) => ({ ...a, kind: 'action' })), ...pkgs.slice(0, 4)];
    return ranked;
  }

  function render(list) {
    items = list;
    active = 0;
    if (list.length === 0) {
      results.innerHTML = '<div class="px-3 py-6 text-center text-sm text-slate-500">No matches</div>';
      return;
    }
    let lastGroup = '';
    results.innerHTML = list
      .map((it, i) => {
        const head =
          it.group && it.group !== lastGroup
            ? `<div class="px-3 py-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">${esc(it.group)}</div>`
            : '';
        lastGroup = it.group || lastGroup;
        return `${head}<button data-idx="${i}" role="option" aria-selected="${i === 0}" class="palette-item flex w-full items-center justify-between gap-3 rounded-lg mx-2 px-3 py-2.5 text-sm text-left" style="width: calc(100% - 1rem)"><span class="font-medium text-slate-200">${esc(it.title)}</span><span class="shrink-0 text-xs text-slate-500">${esc(it.sub || it.hint || '')}</span></button>`;
      })
      .join('');
    highlight();
    results.querySelectorAll('.palette-item').forEach((btn) => {
      btn.addEventListener('click', () => activate(parseInt(btn.dataset.idx, 10)));
    });
  }

  function highlight() {
    results.querySelectorAll('.palette-item').forEach((btn, i) => {
      const on = i === active;
      btn.classList.toggle('palette-active', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
      if (on) btn.scrollIntoView({ block: 'nearest' });
    });
  }

  function activate(i) {
    const it = items[i];
    if (!it) return;
    close();
    if (it.kind === 'action') it.run();
    else window.location.href = it.path;
  }

  function open() {
    palette.classList.remove('hidden');
    input.value = '';
    search('').then(render);
    setTimeout(() => input.focus(), 0);
  }

  function close() {
    palette.classList.add('hidden');
  }

  let debounce;
  input.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => search(input.value).then(render), 120);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      active = Math.min(active + 1, items.length - 1);
      highlight();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      active = Math.max(active - 1, 0);
      highlight();
    } else if (e.key === 'Enter') {
      activate(active);
    } else if (e.key === 'Escape') {
      close();
    }
  });
  document.getElementById('zz-palette-backdrop').addEventListener('click', close);
  window.addEventListener('zz-open-palette', open);
</script>
