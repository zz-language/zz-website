---
import Icon from '../icons/Icon.astro';
import site from '../../config/site.json';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border">
  <nav class="max-w-6xl mx-auto px-4 md:px-6 h-14 flex items-center justify-between" aria-label="Main">
    <a href="/" class="flex items-center gap-2 text-foreground font-mono font-semibold">
      <img src="/500-500-logo.png" alt="ZZ logo" width="26" height="26" class="rounded-md" />
      <span class="hidden sm:inline text-sm">ZZ Language</span>
    </a>

    <div class="hidden md:flex items-center gap-1 text-sm">
      <a href={site.docsPath} class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
        Docs
      </a>
      <a href="/playground" class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
        Playground
      </a>
      <a href={site.pkgRegistryPath} class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
        Packages
      </a>
    </div>

    <div class="flex items-center gap-1">
      <button
        id="nav-search"
        class="hidden sm:flex items-center gap-2 px-2.5 py-1.5 rounded-md border border-border text-xs text-faint hover:text-muted hover:border-accent-border"
        aria-label="Search (Ctrl+K)"
      >
        <Icon name="search" size={14} />
        <span>Search</span>
        <kbd class="font-mono text-[10px] border border-border rounded px-1">⌘K</kbd>
      </button>
      <button
        id="theme-toggle"
        class="p-2 rounded-md text-muted hover:text-foreground hover:bg-raised"
        aria-label="Toggle theme"
      >
        <span class="theme-icon-dark"><Icon name="sun" size={18} /></span>
        <span class="theme-icon-light hidden"><Icon name="moon" size={18} /></span>
      </button>
      <span id="nav-auth">
        <a
          href="/login"
          class="px-3 py-1.5 rounded-md text-sm text-muted hover:text-foreground hover:bg-raised"
        >
          Log in
        </a>
      </span>
      <a
        href={site.githubRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-md text-muted hover:text-foreground hover:bg-raised"
        aria-label="ZZ on GitHub"
      >
        <Icon name="github" size={18} />
      </a>
      <button
        id="nav-menu-btn"
        class="md:hidden p-2 rounded-md text-muted hover:text-foreground hover:bg-raised"
        aria-label="Open menu"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </nav>

  <div id="nav-menu" class="hidden md:hidden border-t border-border px-4 py-3 flex flex-col gap-1 text-sm">
    <a href={site.docsPath} class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Docs</a>
    <a href="/playground" class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Playground</a>
    <a href={site.pkgRegistryPath} class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Packages</a>
    <a href="/login" class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised nav-auth-link">Log in</a>
  </div>

  <div id="user-menu" class="hidden absolute right-4 top-14 w-56 rounded-lg border border-border bg-surface shadow-xl p-1.5 text-sm z-50">
    <div class="px-3 py-2 border-b border-border mb-1">
      <div class="text-xs text-faint">Signed in as</div>
      <div id="user-menu-name" class="font-mono font-medium text-foreground"></div>
    </div>
    <a id="user-menu-pkgs" href="/pkg/author" class="flex items-center gap-2 px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">
      <Icon name="package" size={16} /> My packages
    </a>
    <a href="/pkg/tokens" class="flex items-center gap-2 px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">
      <Icon name="key" size={16} /> API tokens
    </a>
    <button id="user-menu-logout" class="w-full flex items-center gap-2 px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">
      <Icon name="logout" size={16} /> Log out
    </button>
  </div>
</header>

<script>
  function zzSession() {
    try {
      const login = localStorage.getItem('zz_login') || '';
      const token = localStorage.getItem('zz_token') || '';
      return login && token ? { login, token } : null;
    } catch {
      return null;
    }
  }

  function currentTheme() {
    try {
      return localStorage.getItem('zz-theme') || 'system';
    } catch {
      return 'system';
    }
  }

  function applyThemeSetting(setting) {
    const dark =
      setting === 'dark' ||
      (setting !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    try {
      localStorage.setItem('zz-theme', setting);
    } catch {}
    document.querySelectorAll('.theme-icon-dark').forEach((el) => el.classList.toggle('hidden', !dark));
    document.querySelectorAll('.theme-icon-light').forEach((el) => el.classList.toggle('hidden', dark));
  }

  function syncThemeIcons() {
    const dark = document.documentElement.getAttribute('data-theme') !== 'light';
    document.querySelectorAll('.theme-icon-dark').forEach((el) => el.classList.toggle('hidden', !dark));
    document.querySelectorAll('.theme-icon-light').forEach((el) => el.classList.toggle('hidden', dark));
  }

  function renderAuth() {
    const slot = document.getElementById('nav-auth');
    const session = zzSession();
    if (!session) return;
    slot.innerHTML = '';
    const btn = document.createElement('button');
    btn.className =
      'flex items-center gap-2 pl-1.5 pr-2.5 py-1 rounded-md text-sm text-foreground hover:bg-raised';
    btn.setAttribute('aria-label', 'Account menu');
    btn.innerHTML = `<span class="flex items-center justify-center w-6 h-6 rounded-full bg-accent-soft border border-accent-border text-accent font-mono text-xs font-semibold">${session.login
      .slice(0, 1)
      .toUpperCase()}</span><span class="max-w-24 truncate font-mono text-xs">${session.login}</span>`;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      document.getElementById('user-menu').classList.toggle('hidden');
    });
    slot.appendChild(btn);
    document.getElementById('user-menu-name').textContent = session.login;
    document.getElementById('user-menu-pkgs').setAttribute('href', `/pkg/author?login=${encodeURIComponent(session.login)}`);
    document.querySelectorAll('.nav-auth-link').forEach((a) => (a.style.display = 'none'));
  }

  document.getElementById('user-menu-logout')?.addEventListener('click', () => {
    try {
      localStorage.removeItem('zz_token');
      localStorage.removeItem('zz_login');
    } catch {}
    window.location.reload();
  });
  document.addEventListener('click', (e) => {
    const menu = document.getElementById('user-menu');
    if (menu && !menu.classList.contains('hidden') && !menu.contains(e.target)) {
      menu.classList.add('hidden');
    }
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    applyThemeSetting(next);
  });

  document.getElementById('nav-menu-btn')?.addEventListener('click', () => {
    document.getElementById('nav-menu').classList.toggle('hidden');
  });

  function focusSearch() {
    const candidates = [
      document.getElementById('pkg-search'),
      document.querySelector('starlight-search input, [data-pagefind-ui] input'),
    ];
    for (const el of candidates) {
      if (el && el.offsetParent !== null) {
        el.focus();
        return true;
      }
    }
    return false;
  }
  document.getElementById('nav-search')?.addEventListener('click', () => {
    if (!focusSearch()) window.location.href = '/getting-started';
  });
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (!focusSearch()) window.location.href = '/getting-started';
    }
  });

  window.addEventListener('zz-theme-change', (e) => applyThemeSetting(e.detail));
  window.addEventListener('zz-session-change', renderAuth);
  syncThemeIcons();
  renderAuth();
</script>
