---
import Icon from '../icons/Icon.astro';
import SearchPalette from '../SearchPalette.astro';
import site from '../../config/site.json';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border">
  <nav class="max-w-6xl mx-auto px-4 md:px-6 h-14 flex items-center justify-between" aria-label="Main">
    <a href="/" class="flex items-center gap-2 text-foreground font-mono font-semibold">
      <img src="/500-500-logo.png" alt="ZZ logo" width="26" height="26" class="rounded-md" />
      <span class="hidden sm:inline text-sm">ZZ Language</span>
    </a>

    <div class="hidden md:flex items-center gap-1 text-sm">
      <a href={site.docsPath} class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
        Docs
      </a>
      <a href="/playground" class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
        Playground
      </a>
      <a href={site.pkgRegistryPath} class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
        Packages
      </a>
    </div>

    <div class="flex items-center gap-1">
      <button
        id="nav-search"
        class="hidden sm:flex items-center gap-2 px-2.5 py-1.5 rounded-md border border-border text-xs text-faint hover:text-muted hover:border-accent-border"
        aria-label="Search (Ctrl+K)"
      >
        <Icon name="search" size={14} />
        <span>Search</span>
        <kbd class="font-mono text-[10px] border border-border rounded px-1">⌘K</kbd>
      </button>
      <button
        id="theme-toggle"
        class="p-2 rounded-md text-muted hover:text-foreground hover:bg-raised"
        aria-label="Toggle theme"
      >
        <span class="theme-icon-dark"><Icon name="sun" size={18} /></span>
        <span class="theme-icon-light hidden"><Icon name="moon" size={18} /></span>
      </button>
      <span id="nav-auth">
        <a
          href="/login"
          class="px-3 py-1.5 rounded-md text-sm text-muted hover:text-foreground hover:bg-raised"
        >
          Log in
        </a>
      </span>
      <a
        href={site.githubRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-md text-muted hover:text-foreground hover:bg-raised"
        aria-label="ZZ on GitHub"
      >
        <Icon name="github" size={18} />
      </a>
      <button
        id="nav-menu-btn"
        class="md:hidden p-2 rounded-md text-muted hover:text-foreground hover:bg-raised"
        aria-label="Open menu"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </nav>

  <div id="nav-menu" class="hidden md:hidden border-t border-border px-4 py-3 flex flex-col gap-1 text-sm">
    <a href={site.docsPath} class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Docs</a>
    <a href="/playground" class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Playground</a>
    <a href={site.pkgRegistryPath} class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Packages</a>
    <a href="/login" class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised nav-auth-link">Log in</a>
  </div>
</header>

<SearchPalette />

<script>
  import { initHeader } from '../../lib/header-client';
  initHeader();
</script>
