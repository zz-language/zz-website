---
/**
 * The single Navbar: used by CustomHeader (main site) and SiteHeader
 * (Starlight docs override). One markup, one behavior, all routes.
 */
import Icon from '../icons/Icon.astro';
import SearchPalette from '../SearchPalette.astro';
import site from '../../config/site.json';
---

<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between" aria-label="Main">
  <a href="/" class="flex items-center gap-2">
    <img src="/500-500-logo.png" alt="ZZ logo" class="h-6 w-auto rounded-md" />
    <span class="hidden sm:inline text-sm font-semibold text-accent font-mono">ZZ</span>
  </a>

  <div class="hidden md:flex items-center gap-1 text-sm">
    <a href="/home" data-nav="home" id="nav-home" class="hidden px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
      Home
    </a>
    <a href={site.docsPath} data-nav="docs" class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
      Docs
    </a>
    <a href="/playground" data-nav="playground" class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
      Playground
    </a>
    <a href={site.pkgRegistryPath} data-nav="packages" class="px-3 py-1.5 rounded-md text-muted hover:text-foreground hover:bg-raised">
      Packages
    </a>
  </div>

  <div class="flex items-center gap-1.5">
    <button
      id="nav-search"
      class="hidden h-9 sm:flex items-center gap-3 px-3 rounded-lg bg-surface/80 border border-border text-muted text-xs hover:text-foreground hover:border-accent-border transition"
      aria-label="Search (Ctrl+K)"
    >
      <Icon name="search" size={14} />
      <span>Search</span>
      <kbd class="font-mono text-[10px] border border-border rounded px-1">⌘K</kbd>
    </button>
    <button
      id="theme-toggle"
      class="h-9 w-9 grid place-items-center rounded-lg bg-surface/80 border border-border text-muted hover:text-foreground hover:border-accent-border transition"
      aria-label="Toggle theme"
    >
      <span class="theme-icon-dark"><Icon name="sun" size={18} /></span>
      <span class="theme-icon-light hidden"><Icon name="moon" size={18} /></span>
    </button>
    <span id="nav-auth">
      <a
        href="/login"
        class="flex h-9 items-center px-3 rounded-lg bg-surface/80 border border-border text-sm text-muted hover:text-foreground hover:border-accent-border transition"
      >
        Log in
      </a>
    </span>
    <a
      href={site.githubRepo}
      target="_blank"
      rel="noopener noreferrer"
      class="h-9 w-9 grid place-items-center rounded-lg bg-surface/80 border border-border text-muted hover:text-foreground hover:border-accent-border transition"
      aria-label="ZZ on GitHub"
    >
      <Icon name="github" size={18} />
    </a>
    <button
      id="nav-menu-btn"
      class="md:hidden h-9 w-9 grid place-items-center rounded-lg bg-surface/80 border border-border text-muted hover:text-foreground hover:border-accent-border transition"
      aria-label="Open menu"
    >
      <Icon name="menu" size={18} />
    </button>
  </div>
</nav>

<div id="nav-menu" class="hidden md:hidden border-t border-border px-4 py-3 flex flex-col gap-1 text-sm">
  <a href={site.docsPath} class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Docs</a>
  <a href="/playground" class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Playground</a>
  <a href={site.pkgRegistryPath} class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised">Packages</a>
  <a href="/login" class="px-3 py-2 rounded-md text-muted hover:text-foreground hover:bg-raised nav-auth-link">Log in</a>
</div>

<SearchPalette />

<script>
  import { initHeader } from '../../lib/header-client';
  initHeader();
</script>
