  | 'database'
  | 'cpu'
  | 'terminal'
  | 'play'
  | 'square'
  | 'trash'
  | 'book'
  | 'search'
  | 'package'
  | 'github'
  | 'copy'
  | 'check'
  | 'arrow-right'
  | 'chevron-right'
  | 'alert'
  | 'file'
  | 'layers'
  | 'globe'
  | 'clock'
  | 'code'
  | 'server'
  | 'refresh'
  | 'gauge'
  | 'shield'
  | 'branch'
  | 'menu'
  | 'x'
  | 'sun'
  | 'moon'
  | 'monitor'
  | 'user'
  | 'logout'
  | 'key';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: cls = '' } = Astro.props;

